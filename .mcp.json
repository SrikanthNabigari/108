{
  "mcpServers": {
    "108-ephemeris": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "services/mcp/ephemeris_server.py"],
      "env": {
        "PYTHONPATH": "."
      }
    },
    "108-patterns": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "services/mcp/patterns_server.py"],
      "env": {
        "PYTHONPATH": "."
      }
    },
    "108-context": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "services/mcp/context_server.py"],
      "env": {
        "PYTHONPATH": "."
      }
    },
    "108-knowledge": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "services/mcp/knowledge_server.py"],
      "env": {
        "PYTHONPATH": ".",
        "KNOWLEDGE_PATH": "knowledge",
        "BPHS_KNOWLEDGE_PATH": "../108/knowledge"
      }
    }
  }
}
