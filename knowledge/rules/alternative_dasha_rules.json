    "antardasha_rules": {
      "description": "Each maha-dasha is subdivided into 12 sub-periods",
      "sequence": "Follows same direction as maha-dasha (forward or reverse)",
      "duration_formula": "(sub_sign_duration / total_of_all_12_durations) * maha_duration",
