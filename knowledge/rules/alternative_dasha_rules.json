  "narayana_dasha": {
    "description": "108-year cycle sign-based dasha system from Jaimini astrology",
    "total_cycle_years": 108,
    "calculation_method": "Based on ascendant sign and sign lord positions",
    "starting_point": "Ascendant (Lagna)",
    "progression_rules": {
      "odd_signs": {
        "signs": ["Aries", "Gemini", "Leo", "Libra", "Sagittarius", "Aquarius"],
        "direction": "forward",
        "sequence": "Aries -> Taurus -> Gemini -> ... -> Pisces"
      },
      "even_signs": {
        "signs": ["Taurus", "Cancer", "Virgo", "Scorpio", "Capricorn", "Pisces"],
        "direction": "reverse",
        "sequence": "Taurus -> Aries -> Pisces -> ... -> Gemini"
      }
    },
    "duration_calculation": {
      "description": "Duration varies from 1-12 years based on sign lord's position",
      "algorithm": [
        "1. Identify sign lord (for Scorpio/Aquarius, use stronger co-lord)",
        "2. Count from sign to lord's position (forward, inclusive) = N",
        "3. If sign is odd: duration = N years",
        "4. If sign is even: duration = (12 - N) years, or 12 if N=0",
        "5. If lord is in its own sign: duration = 12 years"
      ],
      "special_cases": {
        "scorpio": {
          "primary_lord": "mars",
          "co_lord": "ketu",
          "rule": "Use stronger lord based on kendra position or higher degree"
        },
        "aquarius": {
          "primary_lord": "saturn",
          "co_lord": "rahu",
          "rule": "Use stronger lord based on kendra position or higher degree"
        }
      }
    },
    "sign_interpretations": {
