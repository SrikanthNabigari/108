  "calculation_methods": {
    "dasha_start_calculation": {
      "method": "Nakshatra based",
      "description": "Find natal Moon's nakshatra, identify its lord in Vimshottari order, calculate remaining years in that dasha",
      "formula": "If born in (P/4) of nakshatra, remaining years = total_dasha_years * (1 - natal_position / 13.33)"
    },
    "antardasha_start_calculation": {
      "method": "Proportional",
      "description": "Each Mahadasha is divided into 9 Antardashas corresponding to all 9 planets in order",
      "formula": "Antardasha_years = Mahadasha_years * (Antardasha_planet_years / 120)"
    },
    "pratyantardasha_calculation": {
      "method": "Proportional",
      "description": "Each Antardasha is further divided into 9 Pratyantardashas",
      "formula": "Pratyantardasha_years = Antardasha_years * (Pratyantardasha_planet_years / 120)"
    }
  },
