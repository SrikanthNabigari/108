        "planet": "mars",
        "conditions": [
          {"type": "mars_in_houses", "houses": [1, 2, 4, 7, 8, 12], "from": ["lagna", "moon", "venus"]}
        ]
      },
      "severity_levels": {
        "high": "Mars in 7th or 8th",
        "medium": "Mars in 1st, 4th, or 12th",
        "low": "Mars in 2nd"
      },
      "effects": [
        "Delay in marriage",
        "Conflict in marriage",
        "Spouse health issues",
        "Possible separation",
        "Aggression in partnerships"
      ],
      "cancellation": [
        {"type": "mars_in_own_sign"},
        {"type": "mars_in_exalted_sign"},
        {"type": "mars_aspected_by_jupiter"},
        {"type": "both_partners_have_mangal_dosha"},
