        "max_virupas": 239,
        "description": "Average positional strength"
      },
      "weak": {
        "min_virupas": 60,
        "max_virupas": 119,
        "description": "Below average strength"
      },
      "very_weak": {
        "min_virupas": 0,
        "max_virupas": 59,
        "description": "Very poor strength"
      }
    },
