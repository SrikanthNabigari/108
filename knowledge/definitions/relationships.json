  "temporary_relationships": {
    "description": "Houses that create temporary friendships and enmities",
    "temporary_friend_houses": [2, 3, 4, 10, 11, 12],
    "temporary_enemy_houses": [1, 5, 6, 7, 8, 9],
    "rules": {
      "friend": "Two planets separated by houses 2, 3, 4, 10, 11, 12 from each other become temporary friends",
      "enemy": "Two planets separated by houses 1, 5, 6, 7, 8, 9 from each other become temporary enemies"
    }
  },
  "compound_relationship_matrix": {
    "description": "Relationship between natural and temporary relationships creates compound relationships",
    "rules": {
      "adhi_mitra": {
        "name": "Intimate Friend",
        "calculation": "friend + friend (natural friend + temporary friend)",
        "strength": "strongest"
      },
      "mitra": {
        "name": "Friend",
        "calculation": "friend + neutral OR friend alone (natural friend without temporary enmity)",
        "strength": "strong"
      },
      "sama": {
        "name": "Neutral",
        "calculation": "friend + enemy (natural friend + temporary enemy) OR enemy + friend (natural enemy + temporary friend)",
        "strength": "moderate"
      },
      "satru": {
        "name": "Enemy",
        "calculation": "enemy + neutral OR enemy alone (natural enemy without temporary friendship)",
        "strength": "strong_negative"
      },
      "adhi_satru": {
        "name": "Bitter Enemy",
        "calculation": "enemy + enemy (natural enemy + temporary enemy)",
        "strength": "strongest_negative"
      }
    }
  },
