  "relationship_types": {
    "adhi_mitra": {
      "english_name": "Intimate Friend",
      "sanskrit_name": "Adhi Mitra",
      "strength_level": 5,
      "description": "Strongest positive relationship - both natural friend and temporary friend"
    },
    "mitra": {
      "english_name": "Friend",
      "sanskrit_name": "Mitra",
      "strength_level": 4,
      "description": "Positive relationship - natural friend or natural friend with temporary neutral"
    },
    "sama": {
      "english_name": "Neutral",
      "sanskrit_name": "Sama",
      "strength_level": 3,
      "description": "Mixed relationship - natural friend with temporary enemy or vice versa"
    },
    "satru": {
      "english_name": "Enemy",
      "sanskrit_name": "Shatru",
      "strength_level": 2,
      "description": "Negative relationship - natural enemy or natural enemy with temporary neutral"
    },
    "adhi_satru": {
      "english_name": "Bitter Enemy",
      "sanskrit_name": "Adhi Shatru",
      "strength_level": 1,
      "description": "Strongest negative relationship - both natural enemy and temporary enemy"
    }
  },
  "calculation_method": {
    "step_1": "Determine natural relationship from natural_relationships object",
    "step_2": "Calculate house distance between planets (1-12 houses in zodiac)",
    "step_3": "Determine temporary relationship based on house distance",
    "step_4": "Combine natural + temporary using compound_relationship_matrix",
    "step_5": "Result is final compound relationship strength"
  },
  "notes": {
    "nodes_are_shadow_planets": "Rahu and Ketu are shadow planets (nodes of the moon), not physical planets",
    "rahu_ketu_houses": "Rahu and Ketu are always 6 houses apart (opposite in zodiac)",
    "temporary_friends": "Planets in houses 2, 3, 4, 10, 11, 12 from each other (kendras, panaphara)",
    "temporary_enemies": "Planets in houses 1, 5, 6, 7, 8, 9 from each other (upachayas, apoklimas)",
    "mutual_friendship": "If A is friend to B, B must be friend to A (symmetric relationship)",
    "practical_application": "Compound relationships help in timing events, predicting planetary effects, and yogas"
  }
}
