# 108 Mobile Gateway - Environment Variables
# Copy to .env and fill in your values

# Supabase (from `supabase start` output)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Database (Supabase local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Redis
REDIS_URL=redis://localhost:6380

# Anthropic (for Guide Agent / Chat)
ANTHROPIC_API_KEY=sk-ant-...

# RevenueCat (webhook verification)
REVENUECAT_WEBHOOK_SECRET=rc_...

# Firebase Cloud Messaging (optional for dev)
FCM_SERVER_KEY=

# Environment
ENV=development

# CORS (comma-separated origins, * for dev)
CORS_ORIGINS=["*"]
